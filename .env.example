# Copie este arquivo para .env e preencha.
# O .env NUNCA deve ser enviado ao GitHub (ja esta no .gitignore).

# --- OAuth client (Sentinel Hub / Statistical API) ---
# Onde criar: https://shapps.dataspace.copernicus.eu/dashboard/#/account/settings
# (User settings -> OAuth clients -> Create). O secret aparece so uma vez.
CDSE_CLIENT_ID=COLE_SEU_CLIENT_ID
CDSE_CLIENT_SECRET=COLE_SEU_CLIENT_SECRET

# --- Conta CDSE (usada no L2 cru) ---
# E o login normal da conta em https://dataspace.copernicus.eu (e-mail e senha).
CDSE_USERNAME=seu-email@exemplo.com
CDSE_PASSWORD=SUA_SENHA

# --- Endpoints da API Copernicus ---
# Ajuste se o provedor mudar os links.
CDSE_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
CDSE_STATS_URL=https://sh.dataspace.copernicus.eu/api/v1/statistics
CDSE_CATALOG_URL=https://catalogue.dataspace.copernicus.eu/odata/v1/Products
CDSE_DOWNLOAD_URL=https://download.dataspace.copernicus.eu/odata/v1/Products

# --- Google Earth Engine (opcional) ---
GEE_PROJECT=seu-projeto-no-earthingine
GEE_DRIVE_FOLDER=CH4_TROPOMI_Brasil

# --- Saida ---
# Pasta base onde os arquivos serao salvos. Vazio = pasta atual.
OUTPUT_DIR=
